# gotunnel server configuration

# Docker image
GOTUNNEL_IMAGE=gotunnel-server:latest
GOTUNNEL_PLATFORM=linux/amd64

# Debug logging
GOTUNNEL_DEBUG=false

# Control port: client connects here
GOTUNNEL_CONTROL_PORT=6000
GOTUNNEL_CONTROL_ADDR=:6000

# SSH tunnel visitor port: visitors connect here to reach client's SSH
GOTUNNEL_SSH_VISITOR_PORT=2222

# RDP tunnel visitor port: visitors connect here to reach client's RDP
GOTUNNEL_RDP_VISITOR_PORT=3389

# VNC tunnel visitor port (uncomment in docker-compose.yml to enable)
# GOTUNNEL_VNC_VISITOR_PORT=5900
