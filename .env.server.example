# Server B deployment config: run an already-built gotunnel image, no source build required.
GOTUNNEL_IMAGE=gotunnel-server:latest

# Windows client A connects to this control port.
GOTUNNEL_CONTROL_ADDR=:6000
GOTUNNEL_CONTROL_PORT=6000

# llmproxy upstream connects to this visitor port.
GOTUNNEL_VISITOR_ADDR=:43090
GOTUNNEL_VISITOR_PORT=43090

GOTUNNEL_DEBUG=false
